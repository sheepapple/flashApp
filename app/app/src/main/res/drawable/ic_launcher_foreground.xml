            android:fillColor="#FFFFFF"
            android:fillAlpha="0.55"
            android:pathData="M32,73 L64,73 A2,2 0 0 1 64,77 L32,77 A2,2 0 0 1 32,73 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.32"
