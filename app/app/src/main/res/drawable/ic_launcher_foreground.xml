    <!--
      Same artwork as ic_flash_logo (bolt + speed lines, drawn in 96-unit coords),
      scaled to 0.85x and centered in the 108 adaptive-icon safe zone. The blue
      background comes from the adaptive-icon's background layer.
    -->
